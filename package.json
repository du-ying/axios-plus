{
  "name": "@dy2019/axios-plus",
  "version": "1.13.2",
  "description": "axios扩展类",
  "type": "module",
  "main": "./dist/AxiosPlus.cjs",
  "module": "./dist/AxiosPlus.js",
  "types": "./dist/AxiosPlus.d.ts",
  "scripts": {
    "build": "tsup src/AxiosPlus.js --format esm,cjs --dts",
    "test": "vitest",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/du-ying/axios-plus.git"
  },
  "keywords": [
    "axios",
    "http",
    "ajax",
    "xhr",
    "promise",
    "node"
  ],
  "author": "du-ying",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/du-ying/axios-plus/issues"
  },
  "homepage": "https://github.com/du-ying/axios-plus#readme",
  "dependencies": {
    "axios": "^1.20.0",
    "qs": "^6.16.0"
  },
  "exports": {
    ".": {
      "types": "./dist/AxiosPlus.d.ts",
      "import": "./dist/AxiosPlus.js",
      "require": "./dist/AxiosPlus.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "~5.6.3",
    "vitest": "^5.0.4"
  },
  "directories": {
    "example": "examples"
  }
}
